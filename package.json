{
    "name": "mainbus",
    "version": "0.1.0",
    "description": "Mainbus: run Claude Code agents against a ticket board",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "./out/main/index.js",
    "packageManager": "pnpm@9.5.0",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build && pnpm run build:cli",
        "build:cli": "vite build -c vite.cli.config.ts --logLevel warn",
        "mainbus": "pnpm run --silent build:cli && node out/cli/mainbus.cjs",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
        "e2e": "pnpm run build && playwright test",
        "site:screenshots": "pnpm run build && playwright test -c scripts/site/playwright.config.ts screenshots",
        "site:check": "node scripts/site/checkLinks.mjs && playwright test -c scripts/site/playwright.config.ts site.spec",
        "icons:preview": "node scripts/icons-preview.mjs",
        "icons:build": "node scripts/icons-build.mjs",
        "build:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-stable.ps1",
        "run:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-stable.ps1"
    },
    "devDependencies": {
        "@huggingface/transformers": "4.3.2",
        "@playwright/test": "1.64.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "axe-core": "4.14.0",
        "drizzle-kit": "0.31.11",
        "electron": "45.2.0",
        "electron-builder": "26.18.0",
        "electron-vite": "6.0.0",
        "jsdom": "29.1.1",
        "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
        "typescript": "5.9.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "0.3.314",
        "@dnd-kit/core": "6.3.1",
        "@mantine/code-highlight": "9.7.4",
        "@mantine/core": "9.7.4",
        "@mantine/hooks": "9.7.4",
        "@mantine/notifications": "9.7.4",
        "@modelcontextprotocol/sdk": "1.32.2",
        "drizzle-orm": "0.45.4",
        "highlight.js": "11.11.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-markdown": "10.1.0",
        "remark-gfm": "^4.0.1",
        "zod": "4.6.7",
        "zustand": "5.0.16"
    }
}
