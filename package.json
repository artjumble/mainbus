{
  "name": "mainbus",
  "version": "0.1.0",
  "description": "Mainbus: run Claude Code agents against a ticket board",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "e2e": "npm run build && playwright test",
    "build:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-stable.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "@dnd-kit/core": "6.3.1",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
