{
  "*": [],
  "Orchestrator": [
    { "emit": { "kind": "session", "sessionId": "e2e-orchestrator-settings" } },
    { "expectModel": { "model": "opus", "effort": "medium" } },
    { "emit": { "kind": "tool_call", "id": "w1", "name": "WebFetch", "input": { "url": "https://docs.waveshare.com/esp32-c6", "prompt": "Summarise" } } },
    { "emit": { "kind": "tool_result", "id": "w1", "ok": true, "summary": "Fetched" } },
    { "emit": { "kind": "tool_call", "id": "w2", "name": "WebSearch", "input": { "query": "esp32-c6 pinout" } } },
    { "emit": { "kind": "tool_result", "id": "w2", "ok": true, "summary": "5 results" } },
    { "emit": { "kind": "message", "text": "First reply, on Opus at medium effort." } },
    { "emit": { "kind": "turn_end", "ok": true } },
    { "waitForSend": true },
    { "expectModel": { "model": "sonnet", "effort": "high" } },
    { "emit": { "kind": "message", "text": "Second reply, on Sonnet at high effort, in the same conversation." } },
    { "emit": { "kind": "turn_end", "ok": true } },
    { "waitForSend": true }
  ]
}
